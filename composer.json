{
    "name": "1994/reviews-statamic",
    "description": "Reviews and ratings for Statamic, collected on your own site: a review form for any entry, moderation in the Control Panel, star ratings, averages and review schema, with verified purchases from Cargo.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": [
        "statamic",
        "statamic-addon",
        "reviews",
        "ratings",
        "star rating",
        "testimonials",
        "cargo"
    ],
    "authors": [
        {
            "name": "1994",
            "email": "hello@1994.co.uk",
            "homepage": "https://1994.co.uk"
        }
    ],
    "support": {
        "email": "hello@1994.co.uk"
    },
    "autoload": {
        "psr-4": {
            "NineteenNinetyFour\\Reviews\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NineteenNinetyFour\\Reviews\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.35"
    },
    "require-dev": {
        "duncanmcclean/statamic-cargo": "^1.15",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "duncanmcclean/statamic-cargo": "Verified purchase badges, reviews from buyers only, and emails asking customers for a review (Cargo ^1.15)."
    },
    "conflict": {
        "duncanmcclean/statamic-cargo": "<1.15"
    },
    "extra": {
        "statamic": {
            "name": "Reviews",
            "description": "Collect reviews and star ratings on your own site, moderate them in the Control Panel, and show averages and review schema. Verified purchases with Cargo.",
            "developer": "1994",
            "developer-url": "https://1994.co.uk"
        },
        "laravel": {
            "providers": [
                "NineteenNinetyFour\\Reviews\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
